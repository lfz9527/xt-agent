# GitLab 实例根地址，例如 https://gitlab.example.local
GITLAB_URL=https://gitlab.example.local

# 建议使用 scope 最小化的 Personal Access Token、Project Access Token 或 Group Access Token。
# 不要把真实 token 写入仓库、Codex 配置文件或聊天内容。
GITLAB_TOKEN=replace-with-a-token

# 可选：如果 API 不在默认的 GITLAB_URL/api/v4，可直接指定完整 API 地址。
# GITLAB_API_URL=https://gitlab.example.local/api/v4

# 可选：true 时禁止所有写操作，只保留查询工具。
# GITLAB_READ_ONLY=false

# 可选：HTTP 请求超时，单位毫秒，默认 30000。
# GITLAB_REQUEST_TIMEOUT_MS=30000
