# 将以下内容合并到 C:\Users\13971\.codex\config.toml。
# 真实 token 请通过 Windows 用户环境变量 GITLAB_TOKEN 注入，勿写入此文件。

[mcp_servers.private_gitlab]
command = "node"
args = ["C:\\Users\\13971\\.codex\\mcp\\private-gitlab\\dist\\src\\index.js"]
startup_timeout_sec = 30

# MCP 进程继承 Codex 启动时的用户环境变量：
# GITLAB_URL、GITLAB_TOKEN，以及可选的 GITLAB_READ_ONLY。
